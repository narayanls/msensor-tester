#: usr/share/msensor-tester/ui/dialogs.py:177
msgid "Takes effect after restarting the app"
msgstr "Vale após reiniciar o aplicativo"

#: usr/share/msensor-tester/ui/dialogs.py:201
msgid ""
"Mouse sensor tracking and polling rate tester for Linux. Reads the raw "
"sensor data directly from evdev, with microsecond kernel timestamps."
msgstr ""
"Teste de rastreio do sensor e de polling rate de mouses para Linux. Lê os "
"dados brutos do sensor direto do evdev, com tempos do kernel em "
"microssegundos."

