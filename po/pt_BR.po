#, python-brace-format
msgid ""
"({n} processes of other users/root are not visible; run with sudo to see "
"them)"
msgstr ""
"({n} processos de outros usuários/root não são visíveis; rode com sudo para "
"vê-los)"

#: usr/share/msensor-tester/core/diagnostics.py:381
msgid "Processes that create virtual input devices (uinput)"
msgstr "Processos que criam dispositivos de entrada virtuais (uinput)"

#: usr/share/msensor-tester/core/diagnostics.py:393
#, python-brace-format
msgid "Listening test ({s} s) — move the mouse and click"
msgstr "Teste de escuta ({s} s) — mova o mouse e clique"

#: usr/share/msensor-tester/core/diagnostics.py:399
msgid "selected"
msgstr "selecionado"

#: usr/share/msensor-tester/core/diagnostics.py:401
msgid "could not open"
msgstr "não foi possível abrir"

#: usr/share/msensor-tester/core/diagnostics.py:403
msgid "nominal"
msgstr "nominal"

#: usr/share/msensor-tester/core/diagnostics.py:405
msgid "raw events"
msgstr "eventos brutos"

#: usr/share/msensor-tester/core/diagnostics.py:406
msgid "motion reports"
msgstr "relatórios de movimento"

#: usr/share/msensor-tester/core/diagnostics.py:406
msgid "clicks"
msgstr "cliques"

#: usr/share/msensor-tester/core/diagnostics.py:407
msgid "rate"
msgstr "taxa"

#: usr/share/msensor-tester/core/diagnostics.py:410
msgid "nothing to listen to (no readable mouse)"
msgstr "nada para escutar (nenhum mouse legível)"

#: usr/share/msensor-tester/core/diagnostics.py:414
msgid "Conclusions"
msgstr "Conclusões"

#: usr/share/msensor-tester/core/diagnostics.py:417
msgid "No mouse (REL_X + REL_Y + BTN_LEFT) was found in /sys/class/input."
msgstr ""
"Nenhum mouse (REL_X + REL_Y + BTN_LEFT) foi encontrado em /sys/class/input."

#: usr/share/msensor-tester/core/diagnostics.py:421
msgid "Some mice are not readable and the udev rule is not installed."
msgstr "Alguns mouses não são legíveis e a regra udev não está instalada."

#: usr/share/msensor-tester/core/diagnostics.py:423
msgid ""
"Some mice are not readable even with the udev rule installed: reconnect the "
"mouse or run 'sudo udevadm trigger --subsystem-match=input --action=change'. "
"The rule only works for the user logged in locally."
msgstr ""
"Alguns mouses não são legíveis mesmo com a regra udev instalada: reconecte o "
"mouse ou execute 'sudo udevadm trigger --subsystem-match=input --"
"action=change'. A regra só vale para o usuário logado localmente."

#: usr/share/msensor-tester/core/diagnostics.py:427
#, python-brace-format
msgid ""
"These mice are grabbed by another program: {names}. While that happens, the "
"kernel delivers the events only to that program."
msgstr ""
"Estes mouses estão capturados por outro programa: {names}. Enquanto isso "
"acontece, o kernel entrega os eventos só para esse programa."

#: usr/share/msensor-tester/core/diagnostics.py:433
#: usr/share/msensor-tester/core/diagnostics.py:436
#, python-brace-format
msgid "Likely culprit: {who}."
msgstr "Provável responsável: {who}."

#: usr/share/msensor-tester/core/diagnostics.py:434
#, python-brace-format
msgid "To stop it: kill {pids}"
msgstr "Para encerrá-lo: kill {pids}"

#: usr/share/msensor-tester/core/diagnostics.py:437
msgid ""
"Close it during the test, or select the virtual device it creates (the "
"polling rate will then be that of the virtual device)."
msgstr ""
"Feche-o durante o teste ou selecione o dispositivo virtual que ele cria (o "
"polling rate medido será o do dispositivo virtual)."

#: usr/share/msensor-tester/core/diagnostics.py:443
msgid ""
"No movement was received from any mouse during the listening test. If you "
"moved the mouse, it is probably grabbed by another program."
msgstr ""
"Nenhum movimento chegou de nenhum mouse durante o teste de escuta. Se você "
"moveu o mouse, ele provavelmente está capturado por outro programa."

#: usr/share/msensor-tester/core/diagnostics.py:446
#, python-brace-format
msgid ""
"The selected device received nothing, but {other} did: select it in the list "
"(or use the Detect button)."
msgstr ""
"O dispositivo selecionado não recebeu nada, mas {other} recebeu: selecione-o "
"na lista (ou use o botão Detectar)."

#: usr/share/msensor-tester/core/diagnostics.py:449
msgid "No problem detected."
msgstr "Nenhum problema detectado."

#: usr/share/msensor-tester/core/diagnostics.py:465
msgid ""
"Collecting information… during the listening test, move the mouse and click."
msgstr ""
"Coletando informações… durante o teste de escuta, mova o mouse e clique."

#: usr/share/msensor-tester/core/diagnostics.py:469
msgid "Move the mouse now"
msgstr "Mova o mouse agora"

#: usr/share/msensor-tester/core/updater.py:122
msgid "No release has been published yet."
msgstr "Nenhum release foi publicado ainda."

#: usr/share/msensor-tester/core/updater.py:124
msgid "GitHub is limiting requests right now. Try again later."
msgstr "O GitHub está limitando as consultas agora. Tente mais tarde."

#: usr/share/msensor-tester/core/updater.py:125
#, python-brace-format
msgid "Could not check for updates (HTTP {code})."
msgstr "Não foi possível verificar atualizações (HTTP {code})."

#: usr/share/msensor-tester/core/updater.py:129
msgid "Could not check for updates. Check your internet connection."
msgstr ""
"Não foi possível verificar atualizações. Confira sua conexão com a internet."

#: usr/share/msensor-tester/core/updater.py:151
msgid "The latest release has no version number."
msgstr "O último release não tem número de versão."

#: usr/share/msensor-tester/core/updater.py:177
msgid "This release has no package to install."
msgstr "Este release não tem pacote para instalar."

#: usr/share/msensor-tester/core/updater.py:207
msgid "The download failed. Check your internet connection."
msgstr "O download falhou. Confira sua conexão com a internet."

#: usr/share/msensor-tester/core/updater.py:211
msgid "The download is incomplete. Try again."
msgstr "O download ficou incompleto. Tente de novo."

#: usr/share/msensor-tester/core/updater.py:214
msgid "The downloaded file is corrupted (checksum mismatch). Try again."
msgstr ""
"O arquivo baixado está corrompido (checksum não confere). Tente de novo."

#: usr/share/msensor-tester/core/updater.py:223
msgid "Automatic installation requires pacman and pkexec."
msgstr "A instalação automática precisa do pacman e do pkexec."

#: usr/share/msensor-tester/core/updater.py:233
msgid "Authorization was not granted."
msgstr "A autorização não foi concedida."

#: usr/share/msensor-tester/core/updater.py:236
msgid "pacman could not install the update:"
msgstr "O pacman não conseguiu instalar a atualização:"

